-- INTEGRATED FPS BOOST + SOUND MUTER SCRIPT
local L = game:GetService("Lighting")
local W = game:GetService("Workspace")
local P = game:GetService("Players")
local S = settings()
local SS = game:GetService("SoundService")
local T = W:FindFirstChildOfClass("Terrain")

-- Helper Function: Optimize Geometry
local function O(v)
    if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
        pcall(function() 
            v.Transparency = 1 
            v.Material = Enum.Material.Plastic
            v.Reflectance = 0
            if v:IsA("BasePart") then
                v.BrickColor = BrickColor.new(155, 155, 155)
            end
        end)
        local c = v:FindFirstChildOfClass("Texture")
        if c then c:Destroy() end
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
        pcall(function() 
            v.Enabled = false
            v.Lifetime = NumberRange.new(0)
        end)
    elseif v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Explosion") or v:IsA("Highlight") or v:IsA("Sound") then
        v:Destroy() 
    end
end

-- Helper Function: Mute Sound Objects
local function MuteSound(obj)
    pcall(function()
        local className = obj.ClassName:lower()
        if className:find("sound") then
            obj.Volume = 0
            obj.Playing = false
            obj.Looped = false
            if obj:FindFirstChild("PlaybackSpeed") then
                obj.PlaybackSpeed = 0
            end
        elseif className == "soundgroup" then
            obj.Volume = 0
        end
    end)
end

